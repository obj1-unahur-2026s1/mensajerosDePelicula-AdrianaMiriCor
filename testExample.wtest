import vehiculo.*
import destino.*
import mensajero.*

describe "tests de Robesto y neo" {
test "Robesto pesa 90 y puede llevar paquete para destino"{
   paquete.serPagado()
   roberto.cambiarTransporte(camion)
   assert.that(roberto.puedeLlevarPaquete (puenteBrooklyn))
 }


test "Neo  con credito no puede llevar paquete no pago a matrix"{
   assert.notThat(neo.puedeLlevarPaquete(matrix))
 }
}